# Copiar a .env y completar. En Railway, cargar estas variables en el panel del servicio.
GEMINI_API_KEY=
# Uno o varios modelos separados por coma (el primero es el preferido)
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash
# Opcional: contacto para el User-Agent (lo piden las políticas de Nominatim/Wikimedia)
CONTACT_EMAIL=
MAX_CONCURRENCY=10
HTTP_TIMEOUT=30

# Base de datos PostgreSQL (cuentas, itinerarios guardados e índice de búsqueda).
# Con docker compose se configura sola; en Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://rumbo:rumbo@localhost:5433/rumbo
# Secreto para firmar las sesiones (JWT). Generar uno largo y aleatorio, p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
