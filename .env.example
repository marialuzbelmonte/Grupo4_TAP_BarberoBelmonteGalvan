# Copiar a .env y completar. En Railway, cargar estas variables en el panel del servicio.
GEMINI_API_KEY=
# Uno o varios modelos separados por coma (el primero es el preferido)
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash
# Opcional: contacto para el User-Agent (lo piden las políticas de Nominatim/Wikimedia)
CONTACT_EMAIL=
MAX_CONCURRENCY=10
HTTP_TIMEOUT=30
